#!/usr/bin/env bash
# needle wrapper - termux-glibc python + proot syscall emulation
unset LD_PRELOAD
# HF engine download uses the Xet backend, broken under Termux glibc
# ("Reqwest error: builder error"); fall back to classic HTTP.
export HF_HUB_DISABLE_XET=1

GLIBC_LIB="$PREFIX/glibc/lib"
GLIBC_PYTHON="$PREFIX/glibc/bin/python"
GLIBC_NEEDLE="$PREFIX/glibc/bin/needle"

if [ ! -f "$GLIBC_PYTHON" ] || [ ! -x "$GLIBC_NEEDLE" ]; then
  echo "Error: termux-glibc or Cactus Needle not found" >&2
  echo "Run: pkg install glibc python-glibc python-pip-glibc" >&2
  exit 1
fi

# proot with host rootfs for syscall translation
# Note: no -- separator, pass args directly after interpreter
exec proot -r / \
  -b /dev:/dev -b /proc:/proc -b /sys:/sys \
  -b "$GLIBC_LIB:/lib" \
  -b "$PREFIX/bin:/bin" \
  "$GLIBC_PYTHON" "$GLIBC_NEEDLE" "$@"